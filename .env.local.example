# Copy this file to .env.local and fill in your Supabase project details.
# Find these at https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used server-side (admin routes, seed script). NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple password gate for /admin until real auth is built. Change this.
ADMIN_ACCESS_CODE=change-me
